    "Marcus can't open this file: it isn't text." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Marcus no puede abrir este archivo: no es texto." } }
      }
    },
    "Marcus couldn't read it as text without losing characters, so it won't open it rather than risk saving a damaged copy over the original." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Marcus no ha podido leerlo como texto sin perder caracteres, y prefiere no abrirlo a arriesgarse a guardar una copia dañada sobre el original." } }
