      }
    },
    "Marcus is outside the Applications folder" : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Marcus está fuera de la carpeta Aplicaciones" } }
      }
    },
    "Move it there so macOS keeps a single copy and finds its Services. Marcus will reopen from its new location." : {
      "localizations" : {
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Muévelo allí para que macOS tenga una sola copia y encuentre sus servicios. Marcus volverá a abrirse desde su nueva ubicación." } }
